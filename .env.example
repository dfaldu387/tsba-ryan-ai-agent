# ─── Copy to .env and fill in ───────────────────────────────────────────────

# Server
PORT=8080
NODE_ENV=development

# Password gate for the whole preview (the brief: "protect with a simple password")
APP_PASSWORD=change-me-before-sharing
# Secret used to sign the session token handed out after a correct password.
SESSION_SECRET=generate-a-long-random-string

# Storage backend:
#   memory   — no database at all (default). Knowledge loads from data/*.json on
#              startup; the approval queue lives in memory (cleared on restart).
#   postgres — PostgreSQL + pgvector + pg-boss (needs DATABASE_URL + migrate + ingest).
STORAGE=memory

# Only needed when STORAGE=postgres. PostgreSQL with the pgvector extension.
DATABASE_URL=postgres://tsba:tsba@localhost:5432/tsba

# ─── LLM: drafting (required) ────────────────────────────────────────────────
# The reply drafter. Model is fixed by the brief.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# ─── Embeddings for RAG retrieval (optional) ─────────────────────────────────
# EMBEDDING_PROVIDER = local | voyage | openai
#   local  — deterministic hashed lexical vectors, no API key (default, dev-friendly)
#   voyage — Voyage AI (Anthropic's recommended embeddings); needs VOYAGE_API_KEY
#   openai — OpenAI text-embedding-3-small reduced to 1024 dims; needs OPENAI_API_KEY
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Retrieval: how many manufacturer answers to pull in beside the always-included rules.
RETRIEVAL_TOP_K=8

# CORS origin for the Vite dev server (only used in development)
WEB_ORIGIN=http://localhost:5173
